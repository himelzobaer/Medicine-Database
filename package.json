{
  "name": "bd-medicine-database",
  "version": "1.0.0",
  "description": "Auto-updating Bangladesh Medicine Database — scraped from Medex.com.bd",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "scrape:listing": "tsx src/scraper/run-listing.ts",
    "scrape:detail": "tsx src/scraper/run-detail.ts",
    "scrape:all": "tsx src/scraper/run-all.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsx src/db/push-supabase.ts",
    "db:seed": "tsx src/db/seed.ts",
    "export:json": "tsx src/export/to-json.ts",
    "export:csv": "tsx src/export/to-csv.ts",
    "export:sqlite": "tsx src/export/to-sqlite.ts",
    "export:all": "tsx src/export/run-all-exports.ts",
    "test": "vitest run"
  },
  "keywords": [
    "medicine",
    "bangladesh",
    "database",
    "pharma",
    "scraper"
  ],
  "author": "ZeroFounder",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
